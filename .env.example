# Kopieer dit bestand naar .env.local en vul de waarden in. Zet dezelfde
# variabelen in Vercel (Production en Preview) onder Settings > Environment Variables.

# Web3Forms access key voor het formulier (https://web3forms.com). Maak de key
# aan op het e-mailadres dat de aanvragen moet ontvangen. De key is per ontwerp
# publiek (NEXT_PUBLIC_), hij bepaalt alleen naar welke inbox het gaat.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
